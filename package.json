{
  "name": "mcp-kit",
  "version": "1.0.0",
  "description": "An interactive CLI for scaffolding ready-to-develop MCP servers and clients in TypeScript or JavaScript.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "cross-env NODE_ENV=development turbo run dev",
    "build": "cross-env NODE_ENV=production turbo run build",
    "test": "vitest run",
    "coverage": "rimraf coverage && vitest run --coverage",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "author": "zhensherlock",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/my-mcp-hub/mcp-kit/issues"
  },
  "homepage": "https://my-mcp-hub.github.io/mcp-kit/",
  "keywords": [
    "mcp",
    "model context protocol",
    "modelcontextprotocol",
    "mcp server",
    "mcp client",
    "mcp kit",
    "mcp cli",
    "cli",
    "scaffolding",
    "project generator",
    "create mcp",
    "create mcp server",
    "create mcp client",
    "typescript",
    "javascript",
    "nodejs",
    "stdio",
    "streamable http"
  ],
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "execa": "^10.0.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.3",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
