{
  "name": "create-mcp-kit",
  "version": "1.0.2",
  "description": "An interactive CLI for scaffolding ready-to-develop MCP servers and clients in TypeScript or JavaScript.",
  "type": "module",
  "author": "zhensherlock",
  "homepage": "https://my-mcp-hub.github.io/mcp-kit/",
  "bin": {
    "create-mcp-kit": "./dist/index.js"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "modelcontextprotocol",
    "mcp server",
    "mcp client",
    "mcp kit",
    "mcp cli",
    "cli",
    "scaffolding",
    "project generator",
    "create mcp",
    "create mcp server",
    "create mcp client",
    "typescript",
    "javascript",
    "nodejs",
    "stdio",
    "streamable http"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT",
  "files": [
    "dist",
    "template",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-mcp-hub/mcp-kit.git"
  },
  "scripts": {
    "clean:dist": "rimraf dist",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "build:types": "tsc --noEmit",
    "build": "npm run clean:dist && npm run build:types && rolldown -c rolldown.config.ts",
    "start": "node ./dist/index.js"
  },
  "bugs": {
    "url": "https://github.com/my-mcp-hub/mcp-kit/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@mcp-tool-kit/shared": "workspace:^",
    "gradient-string": "^3.0.0",
    "handlebars": "^4.7.9",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {}
}
