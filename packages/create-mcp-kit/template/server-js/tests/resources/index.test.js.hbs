{{#if (includes plugins 'vitest')}}
import { describe, expect, test } from 'vitest'

describe('searchResource', () => {
  test.each(Object.entries(global.clients))(
    'should return correct resource content for a valid URI over %s',
    async (_name, client) => {
      expect(
        await client.readResource({
          uri: 'search://hello',
        }),
      ).toMatchObject({
        contents: [
          {
            uri: 'search://hello',
            text: 'search hello',
          },
        ],
      })
    },
  )
})
{{/if}}
