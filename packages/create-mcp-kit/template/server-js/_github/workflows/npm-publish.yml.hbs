{{#if (includes plugins 'github-action')}}
name: npm-publish

on:
  release:
    types: [created]

permissions:
  contents: read
  id-token: write

jobs:
  build:
    if: github.repository == '{{projectName}}'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - name: Install Node
        uses: actions/setup-node@v7
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org/
          package-manager-cache: false

      - name: Install Package
        run: npm ci

{{#if (includes plugins 'style')}}
      - name: Lint
        run: npm run lint

{{/if}}
      - name: Build Package
        run: npm run build

      - name: Pack Package
        run: npm pack

      - name: Upload Package Artifact
        uses: actions/upload-artifact@v7
        with:
          name: npm-package
          path: {{projectName}}-*.tgz

  publish:
    if: github.repository == '{{projectName}}'
    needs: build
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Download Package Artifact
        uses: actions/download-artifact@v8
        with:
          name: npm-package
          path: .

      - name: Install Node
        uses: actions/setup-node@v7
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org/
          package-manager-cache: false

      - name: Publish NPM Package
        run: npm publish *.tgz --provenance --access public
{{/if}}
