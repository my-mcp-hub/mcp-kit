{{#if (includes transports 'streamable')}}
import { createMcpExpressApp } from '@modelcontextprotocol/express'
import { toNodeHandler } from '@modelcontextprotocol/node'
import { createMcpHandler } from '@modelcontextprotocol/server'
import { createServer } from './index.js'

export async function webServer(options) {
  const app = createMcpExpressApp()
  const handler = createMcpHandler(() => createServer(options))
  const nodeHandler = toNodeHandler(handler)

  app.all('/mcp', async (req, res) => {
    await nodeHandler(req, res, req.body)
  })

  const httpServer = app.listen(options.port)
  let closing

  const close = () => {
    closing ??= (async () => {
      const httpClosed = new Promise((resolve, reject) => {
        httpServer.close(error => {
          if (error) {
            reject(error)
          } else {
            resolve()
          }
        })
      })

      await handler.close()
      await httpClosed
    })()
    return closing
  }

  const shutdown = () => {
    close().catch(error => {
      console.error('Failed to close MCP web server', error)
      process.exitCode = 1
    })
  }

  process.once('SIGINT', shutdown)
  process.once('SIGTERM', shutdown)

  console.log(`MCP server started on port ${options.port}. Streamable HTTP endpoint: /mcp`)
}
{{/if}}
