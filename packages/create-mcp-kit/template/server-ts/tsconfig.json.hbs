{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "outDir": "./build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
{{#if (includes plugins 'vitest')}}
  {{#if (includes transports 'streamable')}}
  "include": ["src", "tests", "vitest.config.ts", "vitest.global.ts", "vitest.setup.ts"],
  {{else}}
  "include": ["src", "tests", "vitest.config.ts", "vitest.setup.ts"],
  {{/if}}
{{else}}
  "include": ["src"],
{{/if}}
  "exclude": ["node_modules"],
  "tsc-alias": {
    "verbose": false,
    "resolveFullPaths": true,
    "fileExtensions": {
      "inputGlob": "{js,jsx,mjs}",
      "outputCheck": ["js", "json", "jsx", "mjs"]
    },
    "replacers": {
      "alias": {
        "enabled": true,
        "file": "./scripts/aliasReplacer.cjs"
      }
    }
  }
}
