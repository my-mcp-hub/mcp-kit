{{#if (includes plugins 'vitest')}}
import { describe, expect, test } from 'vitest'

describe('echoPrompt', () => {
  test.each(Object.entries(global.clients))(
    'should return correct prompt content for a valid argument over %s',
    async (_name, client) => {
      expect(
        await client.getPrompt({
          name: 'echo',
          arguments: {
            message: 'hello',
          },
        }),
      ).toMatchObject({
        messages: [
          {
            role: 'user',
            content: {
              type: 'text',
              text: 'Please process this message: hello',
            },
          },
        ],
      })
    },
  )
})
{{/if}}
