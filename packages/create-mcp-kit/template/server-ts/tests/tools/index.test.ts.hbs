{{#if (includes plugins 'vitest')}}
import { describe, expect, test } from 'vitest'

describe('getDataTool', () => {
  test.each(Object.entries(global.clients))('returns data for a valid input over %s', async (_name, client) => {
    expect(
      await client.callTool({
        name: 'GetData',
        arguments: {
          keyword: 'test',
        },
      }),
    ).toMatchObject({
      content: [{ type: 'text', text: 'keyword: test;' }],
    })
  })

  test.each(Object.entries(global.clients))(
    'returns a "not found" response for an unrecognized input over %s',
    async (_name, client) => {
      expect(
        await client.callTool({
          name: 'GetData',
          arguments: {
            keyword: 'error',
          },
        }),
      ).toMatchObject({
        content: [{ type: 'text', text: 'not found' }],
      })
    },
  )

  test.each(Object.entries(global.clients))(
    'returns a "not found" response for empty input over %s',
    async (_name, client) => {
      expect(
        await client.callTool({
          name: 'GetData',
          arguments: {
            keyword: '',
          },
        }),
      ).toMatchObject({
        content: [{ type: 'text', text: 'not found' }],
      })
    },
  )
})
{{/if}}
