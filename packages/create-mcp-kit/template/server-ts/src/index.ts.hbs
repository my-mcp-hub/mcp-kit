#!/usr/bin/env node
import yargs from 'yargs'
import { hideBin } from 'yargs/helpers'
{{#if (and (includes transports 'stdio') (includes transports 'streamable'))}}
import { startStdioServer, startWebServer } from './services'
{{else if (includes transports 'stdio')}}
import { startStdioServer } from './services'
{{else}}
import { startWebServer } from './services'
{{/if}}
{{#if (includes transports 'streamable')}}
import { DEFAULT_PORT, getServerOptions, getWebServerOptions, parsePort } from './utils'
{{else}}
import { getServerOptions } from './utils'
{{/if}}
import 'dotenv/config'
import pkg from '../package.json' with { type: 'json' }

const name = '{{projectName}}'
const identity = {
  name,
  version: pkg.version,
}
{{#if (includes transports 'stdio')}}

const startStdio = () => {
  startStdioServer(getServerOptions(identity))
}
{{/if}}
{{#if (includes transports 'streamable')}}

const addPortOption = (command: ReturnType<typeof yargs>) =>
  command.option('port', {
    describe: 'Port for the Streamable HTTP transport',
    type: 'number',
    default: process.env.PORT ?? DEFAULT_PORT,
    coerce: parsePort,
  })

const startWeb = (argv: { port: unknown }) => startWebServer(getWebServerOptions(argv, identity))
{{/if}}

try {
  await yargs(hideBin(process.argv))
    .scriptName(name)
    .usage('$0 [command] [options]')
{{#if (includes transports 'stdio')}}
    .command('$0', 'Start the server using the stdio transport protocol.', command => command, startStdio)
    .command('stdio', 'Start the server using the stdio transport protocol.', command => command, startStdio)
{{else}}
    .command('$0', 'Start the server using Streamable HTTP.', addPortOption, startWeb)
{{/if}}
{{#if (includes transports 'streamable')}}
    .command('web', 'Start the server using Streamable HTTP.', addPortOption, startWeb)
{{/if}}
    .strict()
    .recommendCommands()
    .version(pkg.version)
    .help()
    .showHelpOnFail(false)
    .exitProcess(false)
    .fail((message, error) => {
      throw error ?? new Error(message)
    })
    .parse()
} catch (error) {
  const message = error instanceof Error ? error.message : String(error)
  console.error(`${name}: ${message}`)
  process.exitCode = 1
}
