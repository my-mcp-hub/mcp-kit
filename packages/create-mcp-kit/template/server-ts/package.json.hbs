{
  "name": "{{projectName}}",
  "version": "0.0.0",
  "description": "{{projectName}}",
  "author": "zhensherlock",
  "type": "module",
  "license": "MIT",
  "bin": {
    "{{projectName}}": "./build/index.js"
  },
  "files": [
    "build",
    "LICENSE",
    "README.md"
  ],
  "main": "build/index.js",
  "scripts": {
{{#if (includes plugins 'style')}}
    "lint": "npx eslint \"src/**/*.{ts,js}\"",
{{/if}}
    "build": "tsc --noEmit && cross-env NODE_ENV=production node scripts/build.js",
{{#if (and (includes transports 'stdio') (includes transports 'streamable'))}}
    "dev": "npm run dev:stdio",
    "dev:stdio": "cross-env NODE_ENV=local concurrently \"tsc --noEmit --watch\" \"node scripts/dev.js\"",
    "dev:web": "cross-env NODE_ENV=local TRANSPORT=web concurrently \"tsc --noEmit --watch\" \"node scripts/dev.js\"",
{{else if (includes transports 'stdio')}}
    "dev": "npm run dev:stdio",
    "dev:stdio": "cross-env NODE_ENV=local concurrently \"tsc --noEmit --watch\" \"node scripts/dev.js\"",
{{else}}
    "dev": "npm run dev:web",
    "dev:web": "cross-env NODE_ENV=local TRANSPORT=web concurrently \"tsc --noEmit --watch\" \"node scripts/dev.js\"",
{{/if}}
{{#if (includes plugins 'vitest')}}
    "test": "vitest run",
    "report": "c8 report --reporter=lcov --reporter=html",
    "coverage": "rimraf coverage && npm run test && npm run report",
{{/if}}
{{#if (includes plugins 'changelog')}}
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0 -n changelog-option.js",
{{/if}}
    "prepare": "husky"
  },
  "dependencies": {
{{#if (includes transports 'streamable')}}
    "@modelcontextprotocol/express": "^2.0.0-beta.5",
    "@modelcontextprotocol/node": "^2.0.0-beta.5",
{{/if}}
    "@modelcontextprotocol/server": "^2.0.0-beta.5",
    "dotenv": "^17.4.2",
{{#if (includes transports 'streamable')}}
    "express": "^5.2.1",
{{/if}}
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
{{#if (includes plugins 'commitlint')}}
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
{{/if}}
{{#if (includes plugins 'inspector')}}
    "@modelcontextprotocol/inspector": "^1.0.0",
{{/if}}
{{#if (includes plugins 'vitest')}}
    "@modelcontextprotocol/client": "^2.0.0-beta.5",
{{/if}}
{{#if (includes transports 'streamable')}}
    "@types/express": "^5.0.6",
{{/if}}
    "@types/node": "^22.20.1",
    "@types/yargs": "^17.0.35",
{{#if (includes plugins 'style')}}
    "typescript-eslint": "^8.65.0",
{{/if}}
{{#if (includes plugins 'vitest')}}
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^12.0.0",
{{/if}}
{{#if (includes plugins 'changelog')}}
    "compare-func": "^2.0.0",
{{/if}}
    "concurrently": "^10.0.4",
{{#if (includes plugins 'changelog')}}
    "conventional-changelog-angular": "^8.3.1",
    "conventional-changelog-cli": "^5.0.0",
{{/if}}
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
{{#if (includes plugins 'style')}}
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
{{/if}}
    "husky": "^9.1.7",
{{#if (includes plugins 'style')}}
    "lint-staged": "^17.2.0",
{{/if}}
{{#if (includes plugins 'vitest')}}
    "nyc": "^18.0.0",
{{/if}}
{{#if (includes plugins 'style')}}
    "prettier": "^3.9.6",
{{/if}}
{{#if (includes plugins 'inspector')}}
    "tree-kill": "^1.2.2",
{{/if}}
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
{{#if (includes plugins 'vitest')}}
    "vitest": "^4.1.10",
{{/if}}
    "rimraf": "^6.1.3"
  }
}
