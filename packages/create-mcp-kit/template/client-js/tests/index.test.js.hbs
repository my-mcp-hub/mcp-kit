{{#if (includes plugins 'vitest')}}
import { describe, expect, test } from 'vitest'
{{#if (and (includes transports 'stdio') (includes transports 'streamable'))}}
import { testStdioTransport, testStreamableHttpTransport } from '@/index.js'
{{else if (includes transports 'stdio')}}
import { testStdioTransport } from '@/index.js'
{{else}}
import { testStreamableHttpTransport } from '@/index.js'
{{/if}}

describe('MCP client', () => {
{{#if (includes transports 'stdio')}}
  test('stdio transport', async () => {
    const result = await testStdioTransport()

    expect(result.protocolVersion).toBeDefined()
    expect(result.tools.map(tool => tool.name)).toContain('GetData')
    expect(result.callResult).toMatchObject({
      content: [{ type: 'text', text: 'keyword: Hello;' }],
    })
  })
{{/if}}
{{#if (includes transports 'streamable')}}

  test('streamable http transport', async () => {
    const result = await testStreamableHttpTransport()

    expect(result.protocolVersion).toBeDefined()
    expect(result.tools.map(tool => tool.name)).toContain('GetData')
    expect(result.callResult).toMatchObject({
      content: [{ type: 'text', text: 'keyword: Hello;' }],
    })
  })
{{/if}}
})
{{/if}}
