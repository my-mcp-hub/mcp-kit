{{#if (includes plugins 'vitest')}}
import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest'
import { main } from '../src/index.js'

const createDependencies = () => ({
{{#if (includes transports 'stdio')}}
  runStdioDemo: vi.fn().mockResolvedValue({ selectedDocument: { id: 'mcp-overview' } }),
{{/if}}
{{#if (includes transports 'streamable')}}
  runStreamableHttpDemo: vi.fn().mockResolvedValue({ selectedDocument: { id: 'transport-and-lifecycle' } }),
{{/if}}
  logger: { log: vi.fn(), error: vi.fn() },
})

describe('main', () => {
  const originalExitCode = process.exitCode
  beforeEach(() => { process.exitCode = undefined })
  afterEach(() => { process.exitCode = originalExitCode })
  test('runs configured demos', async () => {
    const dependencies = createDependencies()
    await main(dependencies)
    expect(dependencies.logger.error).not.toHaveBeenCalled()
  })
  test('sets a failing exit code when a demo fails', async () => {
    const dependencies = createDependencies()
    const error = new Error('demo failed')
{{#if (includes transports 'stdio')}}
    dependencies.runStdioDemo.mockRejectedValueOnce(error)
{{else}}
    dependencies.runStreamableHttpDemo.mockRejectedValueOnce(error)
{{/if}}
    await main(dependencies)
    expect(dependencies.logger.error).toHaveBeenCalledWith('Main error:', error)
    expect(process.exitCode).toBe(1)
  })
})
{{/if}}
