import 'dotenv/config'
import { pathToFileURL } from 'node:url'
{{#if (and (includes transports 'stdio') (includes transports 'streamable'))}}
import { runStdioDemo, runStreamableHttpDemo } from './transports.js'
{{else if (includes transports 'stdio')}}
import { runStdioDemo } from './transports.js'
{{else}}
import { runStreamableHttpDemo } from './transports.js'
{{/if}}

export { createClient } from './client.js'
export { runKnowledgeBaseDemo } from './knowledgeBaseDemo.js'
{{#if (and (includes transports 'stdio') (includes transports 'streamable'))}}
export { runStdioDemo, runStreamableHttpDemo } from './transports.js'
{{else if (includes transports 'stdio')}}
export { runStdioDemo } from './transports.js'
{{else}}
export { runStreamableHttpDemo } from './transports.js'
{{/if}}

const defaultDependencies = {
{{#if (includes transports 'stdio')}}
  runStdioDemo,
{{/if}}
{{#if (includes transports 'streamable')}}
  runStreamableHttpDemo,
{{/if}}
  logger: console,
}

export async function main(dependencies = defaultDependencies) {
  try {
{{#if (includes transports 'stdio')}}
    const stdioResult = await dependencies.runStdioDemo()
    dependencies.logger.log('stdio demo:', stdioResult.selectedDocument)
{{/if}}
{{#if (includes transports 'streamable')}}

    const httpResult = await dependencies.runStreamableHttpDemo()
    dependencies.logger.log('streamable HTTP demo:', httpResult.selectedDocument)
{{/if}}
  } catch (error) {
    dependencies.logger.error('Main error:', error)
    process.exitCode = 1
  }
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  await main()
}
