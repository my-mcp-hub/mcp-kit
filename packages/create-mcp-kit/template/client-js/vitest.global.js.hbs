{{#if (and (includes plugins 'vitest') (includes transports 'streamable'))}}
import path from 'node:path'
import { spawn } from 'child_process'
import { waitForValue } from './tests/utils'

export default async function setup() {
  const serverRoot = path.resolve(process.cwd(), '../mcp-server-starter')
  const webProcess = spawn('npx', ['tsx', './src/index.js', 'web'], {
    cwd: serverRoot,
    stdio: 'pipe',
  })
  let webStarted = false
  webProcess.stdout.on('data', data => {
    const output = data.toString()
    if (output.includes('MCP server started')) {
      webStarted = true
    }
  })
  await waitForValue(() => webStarted, 100, 30000)
  return () => {
    webProcess.kill('SIGINT')
  }
}
{{/if}}
