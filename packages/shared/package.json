{
  "name": "@mcp-tool-kit/shared",
  "version": "1.0.2",
  "description": "Shared scaffolding utilities for the MCP Kit CLI.",
  "type": "module",
  "author": "zhensherlock",
  "homepage": "https://my-mcp-hub.github.io/mcp-kit/",
  "keywords": [
    "mcp",
    "model context protocol",
    "modelcontextprotocol",
    "mcp kit",
    "scaffolding",
    "project generator",
    "project template",
    "handlebars",
    "typescript",
    "nodejs"
  ],
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-mcp-hub/mcp-kit.git"
  },
  "scripts": {
    "clean:dist": "rimraf dist",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run clean:dist && npm run build:types && rolldown -c rolldown.config.ts"
  },
  "bugs": {
    "url": "https://github.com/my-mcp-hub/mcp-kit/issues"
  },
  "dependencies": {
    "handlebars": "^4.7.9"
  }
}
